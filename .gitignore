# --- Secrets ---
.env
*.env

# --- Databases (Member 3's event store churns constantly) ---
*.db
*.sqlite
*.sqlite3

# --- Model weights (large, regenerable — don't bloat the repo) ---
*.pt
*.pth
*.onnx
*.weights

# --- Evidence frames (regenerated by runs — keep the folder, not the images) ---
shared/evidence/*
!shared/evidence/.gitkeep

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# --- OS / editor cruft ---
.DS_Store
.vscode/
.idea/

# --- Streamlit ---
.streamlit/secrets.toml

# --- Roboflow / dataset exports (large, re-downloadable) ---
*.zip
datasets/

# --- behaviour-risk local scratch output (standalone-run fallback log, not the real event store) ---
behaviour-risk/output/

# --- Claude Code personal settings (per-person permission overrides, not shared with the team) ---
.claude/settings.local.json

# --- Demo/test videos (large, sourced from the challenge doc's Drive folder — not committed) ---
shared/*.mp4
